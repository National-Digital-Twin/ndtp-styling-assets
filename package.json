{
  "name": "ndtp-styling-assets",
  "version": "0.0.1",
  "description": "",
  "main": "dist/css/styles.css",
  "style": "dist/scss/main.scss",
  "type": "module",
  "files": [
    "dist/css/styles.css",
    "dist/scss/**/*.scss"
  ],
  "exports": {
    ".": {
      "import": "./dist/css/styles.css",
      "require": "./dist/css/styles.css"
    },
    "./scss": {
      "import": "./dist/scss/main.scss",
      "require": "./dist/scss/main.scss"
    }
  },
  "scripts": {
    "clean": "rimraf node_modules package-lock.json",
    "build": "webpack --mode production",
    "dev": "webpack --mode development",
    "vite:dev": "vite",   
    "vite:build": "vite build",
    "vite:preview": "vite preview" 
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^7.1.2",
    "mini-css-extract-plugin": "^2.9.2",
    "rimraf": "^6.0.1",
    "sass": "^1.84.0",
    "sass-loader": "^16.0.4",
    "style-loader": "^4.0.0",
    "vite": "^6.1.0",
    "vite-plugin-static-copy": "^2.2.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
